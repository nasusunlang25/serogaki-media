          "w": "48%",
          "c": "amber"
        }
      ]
    },
    {
      "scene": 3,
      "text": "しかもそれは、睡眠の長さより、強い関係でした。",
      "sub": "しかもそれは、睡眠の「長さ」より\n強い関係でした",
      "hl": [
        {
